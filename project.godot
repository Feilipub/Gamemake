; Lida no Sertão — RF Games
; Projeto Godot 4.7. A raiz do repositório é a raiz do projeto (res://).
; Código em src/, arte e dados em assets/, testes em tests/.

config_version=5

[application]

config/name="Lida no Sertão"
config/description="Vida de vaqueiro no sertão baiano — RF Games"
config/version="0.1.0"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://assets/art/icon.png"

[autoload]

GameData="*res://src/core/game_data.gd"
Music="*res://src/core/music.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
