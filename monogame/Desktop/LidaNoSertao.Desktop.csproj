<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lida no Sertão — versão MonoGame (desktop, OpenGL). O código do jogo fica em ../Shared e é o mesmo do Android. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>LidaNoSertao</AssemblyName>
    <RootNamespace>Lida</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/**/*.cs" />
    <!-- mapa e arte exportados do jogo web (tools/asset-pipeline/export_monogame.js) -->
    <EmbeddedResource Include="../Shared/Assets/*" LogicalName="Assets/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
